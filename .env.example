# Seeker deployment secrets — copy to .env and fill in. Never commit .env.

# -- Engine -------------------------------------------------------------------
# Shared secret for the bearer token; rotate if a device is lost (OD 8).
SEEKER_API_TOKEN=

# Where the engine's durable state (sqlite-vec file) lives on the host.
#SEEKER_SOURCES=/home/you/Documents

# -- Embedding backend (ADR-0001: any OpenAI-compatible endpoint) -------------
# Ollama runs on the host (never in the container); Docker Desktop resolves
# host.docker.internal natively. Defaults below match nomic-embed-text.
#SEEKER_EMBEDDING_BACKEND=openai
#SEEKER_EMBEDDING_MODEL=nomic-embed-text
#SEEKER_EMBEDDING_BASE_URL=http://host.docker.internal:11434
#SEEKER_EMBEDDING_DIMENSIONS=768

# Directory names (comma-separated) pruned from every source at any depth —
# build output, dependency trees, test artifacts. Empty = nothing excluded.
#SEEKER_EXCLUDE_DIRS=node_modules,dist,playwright-report,test-results

# Hosts allowed to call the MCP endpoint besides loopback (the SDK's
# DNS-rebinding guard rejects any other Host header with 421). Comma-
# separated, exact "host:port" or port-wildcard "host:*" (no suffix
# wildcards). Use the Tailscale hostname clients will actually send.
#SEEKER_MCP_ALLOWED_HOSTS=search-engine.your-tailnet.ts.net:*

# -- Tailscale (auth key) -----------------------------------------------------
# The tailscale/tailscale image ignores OAuth client credentials; containerboot
# only reads TS_AUTHKEY (found 2026-11-04). Generate a reusable, non-ephemeral
# auth key tagged tag:seeker at https://login.tailscale.com/admin/settings/keys.
TS_AUTHKEY=

# -- restic backup (docs/build_docs/12-self-hosted-deployment.md) -------------
# B2 example:  b2:<bucket>            + B2_ACCOUNT_ID / B2_APPLICATION_KEY
# S3 example:  s3:s3.amazonaws.com/<bucket>  + AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_INTERVAL_SECONDS=86400
